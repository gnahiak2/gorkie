# Copy to .env and fill in your secrets (.env is gitignored).

# ----------------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------------
NODE_ENV="development"

# ----------------------------------------------------------------------------
# Slack
# ----------------------------------------------------------------------------
# App-level token for Socket Mode (connections:write). https://api.slack.com/apis/connections/socket
SLACK_APP_TOKEN="xapp-your-app-token"
# Bot User OAuth Token (OAuth & Permissions)
SLACK_BOT_TOKEN="xoxb-your-bot-token"
# Slack user token, not the bot token, used for public-channel search. Mint it
# with search:read.public only. gorkie refuses to use it if it also grants
# search:read.im, search:read.mpim, or search:read.private, since those can read
# DMs and private channels. See docs/slack-search.md.
SLACK_USER_TOKEN="xoxp-your-user-token"
# The Slack account allowed to change the model from the App Home. Everyone
# else can use the bot, but not the picker.
OWNER_USER_ID="U0123456789"

# ----------------------------------------------------------------------------
# Models
# ----------------------------------------------------------------------------
# Command Code Provider API. https://commandcode.ai/docs/provider
COMMANDCODE_API_KEY="your-command-code-api-key"

# ----------------------------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gorkie"

# ----------------------------------------------------------------------------
# Credential encryption. Encrypts the MCP tokens people connect, at rest.
# 32 bytes, base64. Generate one with: openssl rand -base64 32
# ----------------------------------------------------------------------------
CREDENTIALS_KEY="your-base64-32-byte-key"

# Optional. Passed to the local sandbox so AgentMail tooling a command runs can
# authenticate. There is no firewall to broker it through, so the key is
# present in the sandbox environment while a turn runs.
AGENTMAIL_API_KEY=""

# ----------------------------------------------------------------------------
# Slack emoji upload (Hack Club proxy). Optional. Enables upload_emoji.
# https://hackclub-slack-emoji-proxy.vercel.app
# ----------------------------------------------------------------------------
EMOJI_PROXY_TOKEN=""
